<Window x:Class="MDExport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        xmlns:local="clr-namespace:MDExport"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MDExport"
        Width="1280"
        Height="800"
        MinWidth="740"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Icon="/Assets/icon.png">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="NewCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAsCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Close" Executed="CloseCommand_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.InsertSnippetCommand}" Executed="InsertSnippet_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.RunActionCommand}" Executed="RunAction_Executed" />
        <CommandBinding Command="ApplicationCommands.Help" Executed="ShowReference_Executed" />
        <!-- Reached only when the code editor does not have focus, which handles these itself. -->
        <CommandBinding Command="ApplicationCommands.Undo" CanExecute="PageCommand_CanExecute" Executed="PageCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Redo" CanExecute="PageCommand_CanExecute" Executed="PageCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Cut" CanExecute="PageCommand_CanExecute" Executed="PageCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Copy" CanExecute="PageCommand_CanExecute" Executed="PageCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Paste" CanExecute="PageCommand_CanExecute" Executed="PageCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.SelectAll" CanExecute="PageCommand_CanExecute" Executed="PageCommand_Executed" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <!-- File and view -->
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="ApplicationCommands.SaveAs" />
        <KeyBinding Key="F2" Command="{x:Static local:MainWindow.RunActionCommand}" CommandParameter="toggle-edit" />
        <KeyBinding Modifiers="Control" Key="E" Command="{x:Static local:MainWindow.RunActionCommand}" CommandParameter="view-edit" />
        <KeyBinding Modifiers="Control" Key="P" Command="{x:Static local:MainWindow.RunActionCommand}" CommandParameter="cycle-view" />
        <KeyBinding Modifiers="Control+Shift" Key="P" Command="{x:Static local:MainWindow.RunActionCommand}" CommandParameter="palette" />
        <KeyBinding Modifiers="Control+Shift" Key="O" Command="{x:Static local:MainWindow.RunActionCommand}" CommandParameter="outline" />
        <KeyBinding Modifiers="Control+Shift" Key="E" Command="{x:Static local:MainWindow.RunActionCommand}" CommandParameter="export-again" />
        <KeyBinding Key="F11" Command="{x:Static local:MainWindow.RunActionCommand}" CommandParameter="focus" />
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{x:Static local:MainWindow.RunActionCommand}" CommandParameter="zoom-in" />
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{x:Static local:MainWindow.RunActionCommand}" CommandParameter="zoom-out" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{x:Static local:MainWindow.RunActionCommand}" CommandParameter="zoom-reset" />
        <!-- Headings -->
        <KeyBinding Modifiers="Control" Key="D1" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="h1" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="h2" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="h3" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="h4" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="h5" />
        <KeyBinding Modifiers="Control" Key="D6" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="h6" />
        <!-- Inline -->
        <KeyBinding Modifiers="Control" Key="B" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="bold" />
        <KeyBinding Modifiers="Control" Key="I" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="italic" />
        <KeyBinding Modifiers="Control" Key="K" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="link" />
        <KeyBinding Modifiers="Control" Key="Oem3" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="code-inline" />
        <!-- Blocks -->
        <KeyBinding Modifiers="Control+Shift" Key="Oem3" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="code-block" />
        <KeyBinding Modifiers="Control" Key="Q" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="blockquote" />
        <KeyBinding Modifiers="Control" Key="OemQuestion" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="comment" />
        <!-- Lists -->
        <KeyBinding Modifiers="Control" Key="L" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="ul" />
        <KeyBinding Modifiers="Control+Shift" Key="L" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="ol" />
        <!-- Table -->
        <KeyBinding Modifiers="Control" Key="T" Command="{x:Static local:MainWindow.InsertSnippetCommand}" CommandParameter="table-pipe" />
    </Window.InputBindings>

    <DockPanel>

        <!-- Top bar: the one row of app chrome -->
        <Border x:Name="TopBar"
                DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="0" VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New" Command="ApplicationCommands.New" InputGestureText="Ctrl+N" />
                        <MenuItem Header="_Open..." Command="ApplicationCommands.Open" InputGestureText="Ctrl+O" />
                        <MenuItem x:Name="RecentMenu" Header="Open _Recent" />
                        <Separator />
                        <MenuItem Header="_Save" Command="ApplicationCommands.Save" InputGestureText="Ctrl+S" />
                        <MenuItem Header="Save _As..." Command="ApplicationCommands.SaveAs" InputGestureText="Ctrl+Shift+S" />
                        <Separator />
                        <MenuItem Header="E_xit" Command="ApplicationCommands.Close" InputGestureText="Alt+F4" />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z" />
                        <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y" />
                        <Separator />
                        <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X" />
                        <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
                        <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V" />
                        <Separator />
                        <MenuItem Header="Select _All" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" />
                        <Separator />
                        <MenuItem Header="_Find..." InputGestureText="Ctrl+F" Click="FindMenu_Click" />
                        <MenuItem Header="R_eplace..." InputGestureText="Ctrl+H" Click="ReplaceMenu_Click" />
                    </MenuItem>
                    <MenuItem x:Name="InsertMenu" Header="_Insert" />
                    <MenuItem Header="_View">
                        <MenuItem x:Name="MenuViewWrite" Header="_Write" IsCheckable="True" Tag="view-write" Click="ActionMenu_Click" />
                        <MenuItem x:Name="MenuViewSplit" Header="_Split" IsCheckable="True" Tag="view-split" Click="ActionMenu_Click" />
                        <MenuItem x:Name="MenuViewRead" Header="_Read" IsCheckable="True" Tag="view-read" Click="ActionMenu_Click" />
                        <MenuItem x:Name="MenuViewEdit" Header="Ed_it on Page" IsCheckable="True" InputGestureText="F2" Tag="toggle-edit" Click="ActionMenu_Click" />
                        <MenuItem Header="Next View" InputGestureText="Ctrl+P" Tag="cycle-view" Click="ActionMenu_Click" />
                        <Separator />
                        <MenuItem x:Name="MenuOutline" Header="_Outline" IsCheckable="True" InputGestureText="Ctrl+Shift+O" Tag="outline" Click="ActionMenu_Click" />
                        <MenuItem x:Name="MenuFocus" Header="_Focus Mode" IsCheckable="True" InputGestureText="F11" Tag="focus" Click="ActionMenu_Click" />
                        <Separator />
                        <MenuItem x:Name="MenuWordWrap" Header="Word Wra_p" IsCheckable="True" Tag="word-wrap" Click="ActionMenu_Click" />
                        <MenuItem x:Name="MenuDarkPreview" Header="_Dark Preview" IsCheckable="True" Tag="dark-preview" Click="ActionMenu_Click" />
                        <Separator />
                        <MenuItem Header="Zoom _In" InputGestureText="Ctrl+=" Tag="zoom-in" Click="ActionMenu_Click" />
                        <MenuItem Header="Zoom O_ut" InputGestureText="Ctrl+-" Tag="zoom-out" Click="ActionMenu_Click" />
                        <MenuItem Header="Reset _Zoom" InputGestureText="Ctrl+0" Tag="zoom-reset" Click="ActionMenu_Click" />
                        <Separator />
                        <MenuItem Header="_Command Palette..." InputGestureText="Ctrl+Shift+P" Tag="palette" Click="ActionMenu_Click" />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="_Markdown Syntax..."
                                  Command="ApplicationCommands.Help"
                                  InputGestureText="F1" />
                        <Separator />
                        <MenuItem Header="_About..." Click="About_Click" />
                    </MenuItem>
                </Menu>

                <TextBlock x:Name="DocStateText"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateBadge"
                            Style="{StaticResource UpdateBadgeButton}"
                            Visibility="Collapsed"
                            Margin="0,0,8,0"
                            Content="Update available"
                            Click="UpdateBadge_Click"
                            ToolTip="A new version of MDExport is available. Click to download it." />

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ViewWrite" GroupName="ViewMode" Content="Write" Tag="view-write"
                                         Style="{StaticResource SegmentButton}" Click="ActionMenu_Click"
                                         ToolTip="Editor only (Ctrl+P cycles views)" />
                            <RadioButton x:Name="ViewSplit" GroupName="ViewMode" Content="Split" Tag="view-split"
                                         Style="{StaticResource SegmentButton}" Click="ActionMenu_Click"
                                         ToolTip="Editor and preview (Ctrl+P cycles views)" />
                            <RadioButton x:Name="ViewRead" GroupName="ViewMode" Content="Read" Tag="view-read"
                                         Style="{StaticResource SegmentButton}" Click="ActionMenu_Click"
                                         ToolTip="Preview only (Ctrl+P cycles views)" />
                            <RadioButton x:Name="ViewEdit" GroupName="ViewMode" Content="Edit" Tag="view-edit"
                                         Style="{StaticResource SegmentButton}" Click="ActionMenu_Click"
                                         ToolTip="Edit directly on the page (F2)" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="ExportButton"
                            Style="{StaticResource AccentButton}"
                            Click="ExportButton_Click"
                            AutomationProperties.Name="Export"
                            ToolTip="Export to HTML, PDF or Word">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Export" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Export as _HTML..." Click="ExportHtml_Click" />
                                <MenuItem Header="Export as _PDF..." Click="ExportPdf_Click" />
                                <MenuItem Header="Export as _Word (DOCX)..." Click="ExportDocx_Click" />
                                <Separator />
                                <MenuItem x:Name="ExportAgainItem" Header="Export _Again" InputGestureText="Ctrl+Shift+E"
                                          Tag="export-again" Click="ActionMenu_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Formatting toolbar for Edit view. Nothing here takes focus, so the caret stays on the page. -->
        <Border x:Name="EditBar"
                DockPanel.Dock="Top"
                Visibility="Collapsed"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,3">
            <Border.Resources>
                <Style x:Key="EditBarButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FlatButton}">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="9,4" />
                    <Setter Property="MinWidth" Value="30" />
                    <Setter Property="Margin" Value="1,0" />
                </Style>
                <Style x:Key="EditBarDivider" TargetType="{x:Type Border}">
                    <Setter Property="Width" Value="1" />
                    <Setter Property="Margin" Value="6,4" />
                    <Setter Property="Background" Value="{StaticResource ControlBorderBrush}" />
                </Style>
            </Border.Resources>
            <WrapPanel>
                <Button Style="{StaticResource EditBarButton}" Content="Style  &#x25BE;" Click="EditMenu_Click"
                        ToolTip="Paragraph or heading" AutomationProperties.Name="Paragraph style">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Paragraph" Tag="style:P" Click="EditCommand_Click" />
                            <MenuItem Header="Heading 1" Tag="style:H1" InputGestureText="Ctrl+1" Click="EditCommand_Click" />
                            <MenuItem Header="Heading 2" Tag="style:H2" InputGestureText="Ctrl+2" Click="EditCommand_Click" />
                            <MenuItem Header="Heading 3" Tag="style:H3" InputGestureText="Ctrl+3" Click="EditCommand_Click" />
                            <MenuItem Header="Heading 4" Tag="style:H4" InputGestureText="Ctrl+4" Click="EditCommand_Click" />
                            <MenuItem Header="Heading 5" Tag="style:H5" InputGestureText="Ctrl+5" Click="EditCommand_Click" />
                            <MenuItem Header="Heading 6" Tag="style:H6" InputGestureText="Ctrl+6" Click="EditCommand_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Border Style="{StaticResource EditBarDivider}" />
                <Button Style="{StaticResource EditBarButton}" Content="B" FontWeight="Bold" Tag="bold" Click="EditCommand_Click"
                        ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold" />
                <Button Style="{StaticResource EditBarButton}" Content="I" FontStyle="Italic" Tag="italic" Click="EditCommand_Click"
                        ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic" />
                <Button Style="{StaticResource EditBarButton}" Tag="strike" Click="EditCommand_Click"
                        ToolTip="Strikethrough" AutomationProperties.Name="Strikethrough">
                    <TextBlock Text="S" TextDecorations="Strikethrough" />
                </Button>
                <Button Style="{StaticResource EditBarButton}" Content="&lt;/&gt;" Tag="code" Click="EditCommand_Click"
                        ToolTip="Inline code (Ctrl+`)" AutomationProperties.Name="Inline code" />
                <Border Style="{StaticResource EditBarDivider}" />
                <Button Style="{StaticResource EditBarButton}" Content="Bullets" Tag="bullets" Click="EditCommand_Click"
                        ToolTip="Bulleted list (Ctrl+L)" />
                <Button Style="{StaticResource EditBarButton}" Content="Numbers" Tag="numbers" Click="EditCommand_Click"
                        ToolTip="Numbered list (Ctrl+Shift+L)" />
                <Button Style="{StaticResource EditBarButton}" Content="Checklist" Tag="checklist" Click="EditCommand_Click"
                        ToolTip="Checklist" />
                <Border Style="{StaticResource EditBarDivider}" />
                <Button Style="{StaticResource EditBarButton}" Content="Quote" Tag="quote" Click="EditCommand_Click"
                        ToolTip="Quote (Ctrl+Q)" />
                <Button Style="{StaticResource EditBarButton}" Content="Code Block" Tag="codeblock" Click="EditCommand_Click"
                        ToolTip="Code block (Ctrl+Shift+`)" />
                <Button Style="{StaticResource EditBarButton}" Content="Line" Tag="hr" Click="EditCommand_Click"
                        ToolTip="Horizontal line" AutomationProperties.Name="Horizontal line" />
                <Border Style="{StaticResource EditBarDivider}" />
                <Button Style="{StaticResource EditBarButton}" Content="Link" Click="EditLink_Click"
                        ToolTip="Insert link (Ctrl+K)" />
                <Button Style="{StaticResource EditBarButton}" Content="Image" Click="EditImage_Click"
                        ToolTip="Insert image" />
                <Button Style="{StaticResource EditBarButton}" Content="Table  &#x25BE;" Click="EditMenu_Click"
                        ToolTip="Insert or change a table" AutomationProperties.Name="Table">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Insert Table" InputGestureText="Ctrl+T" Tag="table" Click="EditCommand_Click" />
                            <Separator />
                            <MenuItem Header="Add Row" Tag="row-add" Click="EditCommand_Click" />
                            <MenuItem Header="Add Column" Tag="column-add" Click="EditCommand_Click" />
                            <Separator />
                            <MenuItem Header="Delete Row" Tag="row-delete" Click="EditCommand_Click" />
                            <MenuItem Header="Delete Column" Tag="column-delete" Click="EditCommand_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Status Bar -->
        <StatusBar x:Name="BottomBar" DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusFileText" Text="Untitled" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <CheckBox x:Name="ReopenLastBox"
                          Content="Reopen last document"
                          Foreground="{StaticResource TextMutedBrush}"
                          ToolTip="Open the last document automatically when MDExport starts"
                          Click="ReopenLastBox_Click" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusInfoText" />
            </StatusBarItem>
        </StatusBar>

        <!-- Notification strip. Docked, not floating: nothing WPF can draw over the WebView. -->
        <Border x:Name="InfoBar"
                DockPanel.Dock="Top"
                Visibility="Collapsed"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="InfoText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="InfoActionA" Style="{StaticResource FlatButton}" Foreground="{StaticResource AccentBrush}" Click="InfoAction_Click" />
                    <Button x:Name="InfoActionB" Style="{StaticResource FlatButton}" Foreground="{StaticResource AccentBrush}" Click="InfoAction_Click" />
                    <Button Style="{StaticResource FlatButton}"
                            Content="&#xE711;"
                            FontFamily="{StaticResource IconFontFamily}"
                            FontSize="11"
                            AutomationProperties.Name="Dismiss"
                            ToolTip="Dismiss"
                            Click="InfoClose_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Outline + Editor + Preview -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OutlineColumn" Width="0" />
                <ColumnDefinition x:Name="EditorColumn" Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="1" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Outline -->
            <Border x:Name="OutlinePane"
                    Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Outline" Margin="14,10,8,6" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="OutlineEmptyText" DockPanel.Dock="Top" Margin="14,4" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Headings in your document appear here." />
                    <ListBox x:Name="OutlineList"
                             Margin="4,0"
                             AutomationProperties.Name="Document outline"
                             SelectionChanged="OutlineList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Margin="{Binding Indent}" TextTrimming="CharacterEllipsis"
                                           FontSize="12.5" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Editor -->
            <Grid x:Name="EditorPane" Grid.Column="1">
                <Border Background="{StaticResource EditorBackgroundBrush}">
                    <avalonEdit:TextEditor x:Name="Editor"
                                           Background="Transparent"
                                           Foreground="#FFD4D4D4"
                                           FontFamily="{StaticResource EditorFontFamily}"
                                           FontSize="14"
                                           LineNumbersForeground="#FF6E6E6E"
                                           ShowLineNumbers="True"
                                           WordWrap="True"
                                           Padding="8,6"
                                           TextOptions.TextFormattingMode="Ideal"
                                           AutomationProperties.Name="Markdown editor" />
                </Border>

                <!-- Find / Replace overlay -->
                <Border x:Name="FindPanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,16,0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Opacity="0.45" ShadowDepth="2" />
                    </Border.Effect>
                    <Border.Resources>
                        <Style x:Key="FindIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FlatButton}">
                            <Setter Property="MinWidth" Value="28" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="Margin" Value="2,0,0,0" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
                        </Style>
                    </Border.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Find row -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBox x:Name="FindTextBox"
                                     Width="170"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Find"
                                     TextChanged="FindText_Changed"
                                     KeyDown="FindTextBox_KeyDown" />
                            <ToggleButton x:Name="OptMatchCase" Style="{StaticResource ToggleIconButton}" Content="Aa"
                                          ToolTip="Match case" AutomationProperties.Name="Match case"
                                          Checked="Option_Changed" Unchecked="Option_Changed" />
                            <ToggleButton x:Name="OptWholeWord" Style="{StaticResource ToggleIconButton}" Content="ab"
                                          ToolTip="Whole word" AutomationProperties.Name="Whole word"
                                          Checked="Option_Changed" Unchecked="Option_Changed" />
                            <ToggleButton x:Name="OptRegex" Style="{StaticResource ToggleIconButton}" Content=".*"
                                          ToolTip="Regular expression" AutomationProperties.Name="Regular expression"
                                          Checked="Option_Changed" Unchecked="Option_Changed" />
                            <TextBlock x:Name="FindStatusText"
                                       MinWidth="62"
                                       Margin="8,0,4,0"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <Button Style="{StaticResource FindIconButton}"
                                    Content="&#xE70E;"
                                    AutomationProperties.Name="Find previous"
                                    ToolTip="Find previous (Shift+Enter / Shift+F3)"
                                    Click="FindPrev_Click" />
                            <Button Style="{StaticResource FindIconButton}"
                                    Content="&#xE70D;"
                                    AutomationProperties.Name="Find next"
                                    ToolTip="Find next (Enter / F3)"
                                    Click="FindNext_Click" />
                            <Button Style="{StaticResource FindIconButton}"
                                    Content="&#xE711;"
                                    AutomationProperties.Name="Close find"
                                    ToolTip="Close (Esc)"
                                    Click="CloseFind_Click" />
                        </StackPanel>

                        <!-- Replace row -->
                        <StackPanel x:Name="ReplaceRow"
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,6,0,0"
                                    Visibility="Collapsed">
                            <TextBox x:Name="ReplaceTextBox"
                                     Width="170"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Replace with"
                                     KeyDown="ReplaceTextBox_KeyDown" />
                            <Button Style="{StaticResource FlatButton}"
                                    Margin="4,0,0,0"
                                    FontSize="12"
                                    Content="Replace"
                                    ToolTip="Replace current match (Enter)"
                                    Click="Replace_Click" />
                            <Button Style="{StaticResource FlatButton}"
                                    Margin="2,0,0,0"
                                    FontSize="12"
                                    Content="Replace All"
                                    ToolTip="Replace all matches"
                                    Click="ReplaceAll_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter x:Name="PaneSplitter" Grid.Column="2" />

            <!-- Preview -->
            <Border x:Name="PreviewPane" Grid.Column="3" Background="White">
                <!-- Takes file drops itself: nothing dropped here reaches the window's handlers. -->
                <wv2:WebView2 x:Name="Preview" />
            </Border>
        </Grid>

    </DockPanel>

</Window>
